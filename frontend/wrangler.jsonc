{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siteflow-frontend",
  "main": "./src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
